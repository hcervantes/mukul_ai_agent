{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hcervantes/mukul_ai_agent/schema/facts_sheet.v1.json",
  "title": "Tax Facts Sheet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "clientId", "taxYear", "generatedAt", "identity"],
  "properties": {
    "version": { "const": 1 },
    "clientId": { "type": "string", "description": "Portal user id (account key). Never an SSN." },
    "taxYear": { "type": "integer", "minimum": 2020, "maximum": 2030 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "ssnLast4": { "type": "string", "pattern": "^[0-9]{4}$" },
        "dependents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "relationship", "source"],
            "properties": {
              "name": { "type": "string" },
              "relationship": { "enum": ["child", "parent", "sibling", "spouse", "other"] },
              "monthsInHome": { "type": "integer", "minimum": 1, "maximum": 12 },
              "source": { "$ref": "#/$defs/sourceCitation" }
            }
          }
        }
      }
    },
    "wageIncome": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["employerName", "wages", "source"],
        "properties": {
          "employerName": { "type": "string" },
          "ein": { "$ref": "#/$defs/ein" },
          "wages": { "$ref": "#/$defs/cents" },
          "federalWithholding": { "$ref": "#/$defs/cents" },
          "state": { "type": "string", "minLength": 2, "maxLength": 2 },
          "stateWages": { "$ref": "#/$defs/cents" },
          "stateWithholding": { "$ref": "#/$defs/cents" },
          "ssWages": { "$ref": "#/$defs/cents" },
          "medicareWages": { "$ref": "#/$defs/cents" },
          "docType": { "const": "W-2" },
          "source": { "$ref": "#/$defs/sourceCitation" }
        }
      }
    },
    "otherIncome": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["form", "amount"],
        "properties": {
          "payer": { "type": ["string", "null"] },
          "form": { "enum": ["1099-NEC", "1099-INT", "1099-DIV", "1099-R", "1099-MISC", "K-1", "SSA-1099", "misc"] },
          "description": { "type": "string" },
          "amount": { "$ref": "#/$defs/cents" },
          "federalWithholding": { "$ref": "#/$defs/cents" },
          "state": { "type": "string", "minLength": 2, "maxLength": 2 },
          "stateWithholding": { "$ref": "#/$defs/cents" },
          "source": { "$ref": "#/$defs/sourceCitation" }
        },
      }
    },
    "scheduleC": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "income", "expenses"],
      "properties": {
        "origin": { "const": "books" },
        "income": { "$ref": "#/$defs/cents" },
        "expenses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "amount"],
            "properties": {
              "category": { "type": "string" },
              "amount": { "$ref": "#/$defs/cents" },
              "miles": { "type": "integer", "minimum": 0 },
              "rate": { "$ref": "#/$defs/cents" },
              "origin": { "enum": ["books", "odometer"] }
            }
          }
        },
        "totalExpenses": { "$ref": "#/$defs/cents" }
      }
    },
    "adjustments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "amount"],
        "properties": {
          "type": { "type": "string" },
          "amount": { "$ref": "#/$defs/cents" },
          "source": { "$ref": "#/$defs/sourceCitation" }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue", "severity"],
        "properties": {
          "docId": { "type": "string" },
          "page": { "type": "integer", "minimum": 1 },
          "issue": { "type": "string" },
          "severity": { "enum": ["WARN", "BLOCK"] }
        }
      }
    },
    "missingDocuments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checklistItem"],
        "properties": {
          "checklistItem": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "reviewNotes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "cents": {
      "type": "integer",
      "minimum": 0,
      "description": "Money in integer cents (e.g. $12,345.67 = 1234567). Dollars rendered at display time only."
    },
    "ein": {
      "type": "string",
      "pattern": "^[0-9]{2}-[0-9]{7}$",
      "description": "Employer Identification Number, XX-XXXXXXX"
    },
    "sourceCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docId", "page"],
      "properties": {
        "docId": { "type": "string" },
        "page": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
